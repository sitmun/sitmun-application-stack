###############################################################################
# Development stack announced as http://lvh.me:9000
#
# lvh.me resolves to 127.0.0.1. Nginx forwards that name in X-Forwarded-Host.
# Open the stack at http://lvh.me:9000. A shared link is accepted when its host
# is lvh.me.
#
# The air-gapped default stays profiles/development.env (PUBLIC_HOSTNAME
# localhost). Production sets PUBLIC_HOSTNAME to the real site name.
#
# Usage:
#   1. cp profiles/development-lvh.env .env
#   2. docker compose up -d --force-recreate front
###############################################################################

COMPOSE_PROFILES=postgres
# Opt-in example: COMPOSE_PROFILES=postgres,demo,mbtiles

# --- Base URL ---
PUBLIC_URL_SCHEME=http
PUBLIC_HOSTNAME=lvh.me
PUBLIC_PORT=9000
PUBLIC_NON_STANDARD_PORT=1
PUBLIC_BASE_PATH=/

# --- Container ---
# LOCAL_PORT=9000
# LOCAL_BASE_PATH=/
ENVIRONMENT=development

# --- Database ---
# SITMUN_CONFIG_DIR=development/backend
# DATABASE_TYPE=postgres
# DATABASE_URL=jdbc:postgresql://postgres:5432/
# DATABASE=sitmun3
# DATABASE_USERNAME=sitmun3
# DATABASE_PASSWORD=sitmun3

# --- Liquibase (development seed) ---
# Development profile uses profiles/development/backend with extensive dev/demo data:
# - 42 Liquibase changesets including tourism data, test users, and sample configurations
# - SPRING_LIQUIBASE_CONTEXTS=dev (hardcoded in application.yml)
# Production profiles use minimal seed data (only 7 base changesets)

# --- Hibernate ---
# JPA/Hibernate settings are configured via Spring profiles:
# - Dialect loaded from application-postgres.yml (PostgreSQLDialect)
# - DDL mode defaults to 'none' (Liquibase manages schema)
# Uncomment to override:
# SPRING_JPA_HIBERNATE_DDL_AUTO=none

# --- Proxy ---
# FORCE_USE_OF_PROXY=true

# --- Security ---
# MIDDLEWARE_SECRET=your-secure-secret-here

# --- Development Mode ---
# Spring Boot profile automatically set to match DATABASE_TYPE (postgres)
# Logging levels use defaults from application.yml:
# - LOGGING_LEVEL_ROOT=INFO
# - LOGGING_LEVEL_ORG_SITMUN=DEBUG
# Uncomment to override:
# SPRING_PROFILES_ACTIVE=postgres
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_ORG_SITMUN=DEBUG
